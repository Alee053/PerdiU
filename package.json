{
  "name": "perdiu",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @perdiu/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "node scripts/verify-catalog.mjs",
    "test:e2e": "node scripts/verify-catalog.mjs --with-browser",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "turbo run db:migrate --filter=@perdiu/database",
    "db:seed": "turbo run db:seed --filter=@perdiu/database",
    "preview": "pnpm --filter @perdiu/web preview"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "turbo": "^2.11.7",
    "@perdiu/database": "workspace:*"
  }
}
