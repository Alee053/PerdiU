{
  "name": "@perdiu/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/catalog.integration.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@perdiu/contracts": "workspace:*",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
